+    /// Require a signing identity already backed by the stored private key and
+    /// an active certificate on the selected team; never request or revoke one.
+    pub fn use_existing_certificate_only(&mut self) {
+        self.existing_certificate_mode.use_existing_certificate_only();
+    }
+
+    /// Import a PKCS#12 archive (`.p12`) supplied by the user for the selected
+    /// team. Only the first RSA private key is accepted; its public half must
+    /// match an active certificate on the team, otherwise nothing is stored
+    /// and the request fails without creating or revoking a certificate.
+    ///
+    /// The password is used only to decrypt the archive, never logged. The
+    /// extracted key is stored under this account's usual signing key slot so
+    /// the existing certificate-matching path can sign with it.
+    pub async fn import_p12(
+        &mut self,
+        archive: &[u8],
+        password: &str,
+    ) -> Result<DevelopmentCertificate, Report> {
+        let team = match self.team.clone() {
+            Some(team) => team,
+            None => self.get_team().await?,
+        };
+
+        let keystore = p12_keystore::KeyStore::from_pkcs12(
+            archive,
+            password,
+            p12_keystore::Pkcs12ImportPolicy::Strict,
+        )
+        .map_err(|e| report!("Failed to open the .p12 archive: {e}"))?;
+
+        let mut found: Option<(RsaPrivateKey, DevelopmentCertificate)> = None;
+        for (name, entry) in keystore.entries() {
+            let p12_keystore::KeyStoreEntry::PrivateKeyChain(chain) = entry else {
+                continue;
+            };
+            let private_key = match RsaPrivateKey::from_pkcs8_der(chain.key().as_der()) {
+                Ok(key) => key,
+                Err(e) => {
+                    warn!(entry = %name, "Skipping a non-RSA or unreadable .p12 key: {e}");
+                    continue;
+                }
+            };
+            if let Some((cert, _x509)) =
+                CertificateIdentity::find_matching(&private_key, &mut self.dev_session, &team)
+                    .await
+                    .context("Failed to match the .p12 key against the team's certificates")?
+            {
+                found = Some((private_key, cert));
+                break;
+            }
+        }
+
+        let Some((private_key, cert)) = found else {
+            bail!(
+                "The .p12 key does not match an active development certificate on team {}; nothing was imported or created",
+                team.name
+            );
+        };
+
+        self.storage
+            .store_data(
+                &CertificateIdentity::private_key_storage_key(&self.apple_email),
+                private_key.to_pkcs8_der()?.as_bytes(),
+            )
+            .map_err(|e| report!("Failed to store the imported signing key: {e}"))?;
+
+        Ok(cert)
+    }
